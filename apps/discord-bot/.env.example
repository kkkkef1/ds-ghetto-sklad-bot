# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=

# Application (client) id, same page -> General Information -> Application ID
DISCORD_CLIENT_ID=

# Guild id — with it set, the command registers instantly on this one server
# instead of globally (which can take up to ~1 hour to propagate).
DISCORD_GUILD_ID=1546926301699514411

# Id of the "Логи" category where session channels are created
LOGS_CATEGORY_ID=
