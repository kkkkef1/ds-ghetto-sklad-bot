# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=

# Application (client) id, same page -> General Information -> Application ID
DISCORD_CLIENT_ID=

# NOT read from here anymore — deploy-commands always registers globally so
# commands work on every server the bot is on. For a fast one-off deploy to a
# single server during development, pass it on the command line instead:
#   pnpm --filter @workspace/discord-bot run deploy-commands -- --guild <id>
# (a leftover guild id in this file used to cause new/changed commands to only
# reach that one server and silently never appear anywhere else)

# Id of the "Логи" category where session channels are created
LOGS_CATEGORY_ID=

# Optional: where the capt-tracker feature stores its JSON data (daily
# attack/defense counts, capt records, helper ids). Defaults to
# ./data/capt-store.json relative to the process's working directory.
CAPT_DATA_FILE=

# Optional: where the МП/собрания feature stores its JSON data (settings per
# server, МП schedule, marks, reports). Defaults to ./data/activity-store.json
# relative to the process's working directory.
ACTIVITY_DATA_FILE=

# ===== Модуль проверки склада (warehouse): вход на gta5rp.com =====
# Аккаунт, под которым бот заходит в админку логов. Пароли только здесь, в git не попадают.
GTA_LOGIN=
# Пароль аккаунта (нужен и для окна «Проверка безопасности» при смене IP)
GTA_PASSWORD=
# Отдельный пароль «Админ вход»
GTA_ADMIN_PASSWORD=
# Ваш Discord ID: бот напишет туда в личку и примет код Google Authenticator
# (Discord → Настройки → Расширенные → режим разработчика → ПКМ по себе → Копировать ID)
WH_OWNER_ID=

# Необязательно:
# WH_SERVER_ID=17            # сервер (Redwood = 17), для прототипа
# WH_FACTION=F_GANG_BLOODS   # фракция, для прототипа
# WH_DATE_FROM=09/11/2026    # дата «от», дд/мм/гггг; по умолчанию сегодня (МСК)
# WH_DATA_DIR=./data         # куда класть профиль браузера и скриншоты ошибок
# WH_HEADLESS=1              # 0 — показывать окно браузера (нужен дисплей)
# WH_BLOCK_ASSETS=1          # 1 — не грузить картинки/шрифты (экономит память)
# WH_CODE_TIMEOUT_MIN=5      # сколько ждать код 2FA
# WH_SUBNET_WAIT_MIN=15      # сколько ждать подтверждения подсети главным админом
# Где лежит скачанный Chromium (общая папка для ручного запуска и systemd):
# PLAYWRIGHT_BROWSERS_PATH=/opt/bots/browsers
